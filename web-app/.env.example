# Supabase project — same values as backend/.env; the publishable/anon key is
# browser-safe by design (RLS is the boundary, not key secrecy).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# The FastAPI service. 8001 because 8000 is taken.
VITE_API_URL=http://localhost:8001

# Google OAuth client id (type "Web application") — turns on "import" on the
# to-do calendar. Leave empty to hide it. Browser-safe: it's an id, not a secret.
VITE_GOOGLE_CLIENT_ID=
