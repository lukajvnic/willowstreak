# Supabase project (Project Settings -> API).
# The publishable/anon key is what the API uses for user-scoped requests: the
# caller's access token is attached per request, so PostgREST evaluates RLS as
# that user. The service role key bypasses RLS — only for work with no caller.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated, or a JSON array. The deployed SPA origin plus local vite.
BACKEND_CORS_ORIGINS=http://localhost:5173,https://willo.app

ENVIRONMENT=local
